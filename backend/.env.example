PORT=3000

# Supabase — get these from your Supabase project settings > API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# JWT — generate a strong random secret (e.g. openssl rand -base64 64)
JWT_SECRET=your-jwt-secret
JWT_EXPIRES_IN=7d

# FastAPI ML microservice (ml-service/) — local dev; point at deployed URL in production
ML_SERVICE_URL=http://localhost:8000
