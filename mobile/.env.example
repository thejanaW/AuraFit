# Backend API base URL. Without this, src/services/api.js falls back to
# http://localhost:3000 and the app cannot reach the deployed backend.
#
# Deployed backend (Render): https://aurafit-backend-moic.onrender.com
# Local dev: http://localhost:3000, or http://<your-LAN-IP>:3000 for a
# physical device (localhost resolves to the phone itself, not your machine).
EXPO_PUBLIC_API_URL=https://aurafit-backend-moic.onrender.com
