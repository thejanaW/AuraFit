{
  "expo": {
    "name": "AuraFit",
    "slug": "thejana",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0A0A"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.aurafit.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "AuraFit uses your location to check whether you're close enough to a reward pin to claim it."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A0A0A"
      },
      "package": "com.aurafit.app",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "AuraFit uses your location to check whether you're close enough to a reward pin to claim it."
        }
      ],
      "expo-video",
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "98452b54-a218-4fd4-9bbf-e74112ee3399"
      }
    },
    "owner": "thejanas-team",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/98452b54-a218-4fd4-9bbf-e74112ee3399"
    }
  }
}
